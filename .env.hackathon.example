# Local-only hackathon configuration.
# Copy values into `.env.local` or source them directly in your shell.

MERCHANT_ID=your_merchant_id
PAYMENT_PROFILE_ID=your_payment_profile_id
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
HELIUS_API_KEY=
PAYSH_ENDPOINT=
CLAWDROUTER_OPENROUTER_API_KEY=
CLAWDROUTER_X402_PAY_TO=
CLAWDROUTER_X402_PRICE=10000
CLAWDROUTER_X402_DESCRIPTION=ClawdRouter access
TRUSTBOOST_SANITIZER_ENABLED=false
TRUSTBOOST_SANITIZER_ENDPOINT=https://trustboost-api.onrender.com/sanitize
TRUSTBOOST_TX_HASH=TRIAL
TRUSTBOOST_WALLET_ADDRESS=
TRUSTBOOST_TIMEOUT_MS=2500
TRUSTBOOST_FAIL_OPEN=true
TRUSTBOOST_MIN_TEXT_LENGTH=8
