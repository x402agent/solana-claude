{
  "name": "clawd-automaton",
  "version": "0.2.0",
  "description": "CLAWD Automaton - sovereign AI agent runtime that leads users to x402.wtf/automation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "clawd-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x402agent/openclawd.git",
    "directory": "automaton-main"
  },
  "homepage": "https://x402.wtf/automation",
  "bugs": {
    "url": "https://github.com/x402agent/openclawd/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "three-laws.md",
    "constitution.md"
  ],
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "web4",
    "clawd",
    "self-replicating"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && pnpm -r build",
    "dashboard:dev": "pnpm --filter clawd-dashboard dev",
    "dashboard:build": "pnpm --filter clawd-dashboard build",
    "dev": "tsx watch src/index.ts",
    "ooda": "tsx src/ooda/loop.ts",
    "ooda:tui": "tsx src/ooda/loop.ts --tui | tsx src/ooda/tui.ts",
    "goblin": "tsx src/ooda/loop.ts --goblin --fresh",
    "goblin:tui": "tsx src/ooda/loop.ts --goblin --fresh --tui | tsx src/ooda/tui.ts",
    "test": "vitest run",
    "clean": "rm -rf dist && pnpm -r clean"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.0.0",
    "siwe": "^2.3.0",
    "simple-git": "^3.24.0",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
