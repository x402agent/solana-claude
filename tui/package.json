{
  "name": "@openclawdsolana/clawd-tui",
  "version": "1.2.1",
  "description": "Official Solana Clawd TUI and Metaplex Agent Registry CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hermes": "dist/index.js",
    "clawd-tui": "dist/index.js",
    "clawd-agent": "dist/agent-cli.js",
    "clawd-agent-mint": "dist/agent-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists .env --import tsx/esm src/index.ts",
    "start": "node --env-file-if-exists .env dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-agent-registry": "^0.2.5",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "bs58": "^6.0.0",
    "chalk": "^5.4.0",
    "cli-boxes": "^3.0.0",
    "figures": "^6.1.0",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
