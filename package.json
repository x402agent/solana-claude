{
  "name": "solana-clawd",
  "version": "1.7.0",
  "description": "HERMES x402 — Solana-Native Agentic Harness. First private x402 AI agent with OODA loop, pay.sh confidential payments, Google A2A protocol, dark DeFi intelligence, and Nous Research model routing.",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./animations": {
      "import": "./dist/animations/index.js",
      "types": "./dist/animations/index.d.ts"
    },
    "./buddy": {
      "import": "./dist/buddy/index.js",
      "types": "./dist/buddy/index.d.ts"
    },
    "./metaplex": {
      "import": "./dist/metaplex/index.js",
      "types": "./dist/metaplex/index.d.ts"
    }
  },
  "bin": {
    "solana-clawd": "dist/entrypoints/clawd.js",
    "clawd": "dist/entrypoints/clawd.js"
  },
  "scripts": {
    "build": "node scripts/repo-doctor.mjs --build",
    "macos:menubar:build": "bash apps/macos/build-menubar.sh",
    "macos:swift:build": "swift build --package-path apps/macos --product SolanaOS",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "node scripts/repo-doctor.mjs --typecheck",
    "prebuild": "node -e \"console.log('Building solana-clawd v' + require('./package.json').version)\"",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json --noCheck && node -e \"require('fs').chmodSync('dist/entrypoints/clawd.js', 0o755)\"",
    "mcp:build": "cd MCP && npm ci && npm run build",
    "mcp:start": "cd MCP && npm start",
    "mcp:http": "cd MCP && npm run start:http",
    "packages:install": "for pkg in packages/agentwallet packages/clawd packages/clawd-perps packages/clawd-sdk packages/clawd-wallet packages/cli-standalone; do npm --prefix $pkg install --legacy-peer-deps; done",
    "packages:build": "for pkg in packages/agentwallet packages/clawd packages/clawd-perps packages/clawd-sdk packages/clawd-wallet; do npm --prefix $pkg run build --if-present; done",
    "sdk:install": "npm --prefix sdk install --legacy-peer-deps",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:check": "npm --prefix sdk run check",
    "sdk:library:build": "cd sdk/library && bun run build",
    "sdk:library:test": "cd sdk/library && bun run test",
    "sdk:library:typecheck": "cd sdk/library && bun run type-check",
    "agentwallet:build": "npm --prefix packages/agentwallet install --legacy-peer-deps && npm --prefix packages/agentwallet run build",
    "agentwallet:start": "npm --prefix packages/agentwallet start",
    "clawd:build": "npm --prefix packages/clawd install --legacy-peer-deps && npm --prefix packages/clawd run build",
    "clawd:start": "npm --prefix packages/clawd start",
    "clawd-perps:build": "npm --prefix packages/clawd-perps install --legacy-peer-deps && npm --prefix packages/clawd-perps run build",
    "clawd-sdk:build": "npm --prefix packages/clawd-sdk install --legacy-peer-deps && npm --prefix packages/clawd-sdk run build",
    "clawd-wallet:build": "npm --prefix packages/clawd-wallet install --legacy-peer-deps && npm --prefix packages/clawd-wallet run build",
    "cli-standalone:start": "npm --prefix packages/cli-standalone start",
    "vault:web:build": "npm --prefix llm-wiki-tang/web run build",
    "vault:web:dev": "npm --prefix llm-wiki-tang/web run dev",
    "demo": "node dist/entrypoints/clawd.js demo",
    "birth": "node dist/entrypoints/clawd.js birth",
    "spinners": "node dist/entrypoints/clawd.js spinners",
    "tui": "node --import tsx/esm tui/src/index.ts",
    "tui:build": "cd tui && tsc -p tsconfig.json",
    "tui:start": "node tui/dist/index.js",
    "hermes": "node --import tsx/esm tui/src/index.ts",
    "demo:ooda": "node --import tsx/esm examples/ooda-loop.ts",
    "demo:a2a": "node --import tsx/esm examples/a2a-demo.ts",
    "demo:paysh": "node --import tsx/esm examples/paysh-demo.ts",
    "demo:dark-defi": "node --import tsx/esm examples/dark-defi-demo.ts",
    "ooda": "node --import tsx/esm ooda/loop.ts",
    "ooda:tui": "node --import tsx/esm ooda/loop.ts --tui | node --import tsx/esm ooda/tui.ts",
    "ooda:llm": "node --import tsx/esm ooda/loop.ts --llm --ticks 20",
    "goblin": "node --import tsx/esm ooda/loop.ts --goblin --ticks 100",
    "goblin:tui": "node --import tsx/esm ooda/loop.ts --goblin --tui | node --import tsx/esm ooda/tui.ts",
    "deep": "cd deep-clawd && npx tsx src/index.ts --loop",
    "deep:paper": "cd deep-clawd && PAPER_ONLY=true npx tsx src/index.ts --loop",
    "deep:orient": "cd deep-clawd && npx tsx src/index.ts --orient",
    "deep:goblin": "cd deep-clawd && DFLOW_MODE=aggro npx tsx src/index.ts --loop --ticks=100",
    "deep:install": "cd deep-clawd && npm install",
    "dflow:install": "curl -fsS https://cli.dflow.net | sh",
    "dflow:setup": "dflow setup",
    "dflow:whoami": "dflow whoami",
    "dflow:positions": "dflow positions",
    "dflow:guardrails": "dflow guardrails show",
    "dflow:docs:refresh": "curl -fsSL https://pond.dflow.net/llms.txt -o docs/dflow/llms.txt && curl -fsSL https://pond.dflow.net/ai/agent-cli.md -o docs/dflow/agent-cli.md && curl -fsSL https://pond.dflow.net/ai/agent-skills.md -o docs/dflow/agent-skills.md && curl -fsSL https://pond.dflow.net/build/trading-api/openapi.json -o docs/dflow/trading-api.openapi.json",
    "leviathan": "node --import tsx/esm leviathan/src/index.ts --run",
    "leviathan:spawn": "node --import tsx/esm leviathan/src/index.ts --spawn",
    "leviathan:status": "node --import tsx/esm leviathan/src/index.ts --status",
    "automation:build": "node --import tsx/esm automation/index.ts --build",
    "automation:spawn": "node --import tsx/esm automation/index.ts --spawn",
    "automation:ci": "node --import tsx/esm automation/index.ts --ci",
    "automation:full": "bash automation/leviathan.sh --full",
    "automation:hermes": "bash automation/leviathan.sh --hermes",
    "automation:brain": "bash automation/leviathan.sh --brain",
    "automation:mcp": "bash automation/leviathan.sh --mcp",
    "setup": "bash scripts/setup.sh",
    "repo:audit": "bash scripts/repo-hygiene-audit.sh",
    "lint": "node scripts/repo-doctor.mjs --lint",
    "lint:fix": "biome check --write automation beepboop/worker/src clawdrouter/src gateway/src leviathan/src MCP/src sdk/src scripts",
    "format": "biome format --write automation beepboop/worker/src clawdrouter/src gateway/src leviathan/src MCP/src sdk/src scripts",
    "format:check": "biome format automation beepboop/worker/src clawdrouter/src gateway/src leviathan/src MCP/src sdk/src scripts",
    "check": "npm run typecheck && npm run lint",
    "doctor": "node scripts/repo-doctor.mjs",
    "ci": "npm run check && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "adaptation:report": "node scripts/generate-claude-adaptation-report.mjs",
    "skill:sync": "node scripts/sync-solana-clawd-skill.mjs",
    "skills:catalog": "node scripts/generate-skills-catalog.js",
    "skills:serve": "node scripts/generate-skills-catalog.js && cp skills/catalog.json web/skills/catalog.json && npx serve web/skills -p 3333",
    "ext:dev": "echo 'Load chrome-extension/clawd-agent as unpacked extension in chrome://extensions'",
    "ext:vault": "npm --prefix packages/agentwallet start",
    "brain:init": "cd MemeBRain && python3 -m mnemosyne.clawd_brain init",
    "brain:status": "cd MemeBRain && python3 -m mnemosyne.clawd_brain status",
    "brain:ingest-ooda": "cd MemeBRain && python3 -m mnemosyne.clawd_brain ingest-ooda",
    "brain:mcp": "cd MemeBRain && python3 -m mnemosyne.cli mcp --bank clawd",
    "oracle:check": "cargo check --manifest-path llm_oracle/Cargo.toml",
    "oracle:build": "cargo build --manifest-path llm_oracle/Cargo.toml",
    "oracle:run": "cargo run --manifest-path llm_oracle/Cargo.toml",
    "percolator:install": "cd llm_oracle/percolator-cli-master && pnpm install",
    "percolator:build": "cd llm_oracle/percolator-cli-master && pnpm build",
    "percolator:test": "cd llm_oracle/percolator-cli-master && pnpm test",
    "ptoken:explorer": "node scripts/ptoken-explorer.mjs",
    "ptoken:inspect": "node scripts/ptoken-explorer.mjs inspect",
    "ptoken:add": "node scripts/ptoken-explorer.mjs add",
    "ptoken:list": "node scripts/ptoken-explorer.mjs list",
    "ptoken:show": "node scripts/ptoken-explorer.mjs show",
    "ptoken:launch-plan": "node scripts/ptoken-launch-planner.mjs plan",
    "ptoken:curve-quote": "node scripts/ptoken-launch-planner.mjs quote",
    "ptoken:launcher": "node pinocchio/templates/p-token-launcher/server.mjs",
    "pagent:plan": "node scripts/p-agent-token-planner.mjs plan",
    "pagent:quote": "node scripts/p-agent-token-planner.mjs quote",
    "pinocchio:templates": "node scripts/pinocchio-scaffold.mjs list",
    "pinocchio:scaffold": "node scripts/pinocchio-scaffold.mjs",
    "pinocchio:ptoken:inspect": "node scripts/ptoken-explorer.mjs inspect",
    "pinocchio:ptoken:add": "node scripts/ptoken-explorer.mjs add",
    "pinocchio:ptoken:list": "node scripts/ptoken-explorer.mjs list",
    "pinocchio:ptoken:launch-plan": "node scripts/ptoken-launch-planner.mjs plan",
    "pinocchio:ptoken:curve-quote": "node scripts/ptoken-launch-planner.mjs quote",
    "programs:map": "node scripts/programs-map.mjs list",
    "programs:show": "node scripts/programs-map.mjs show"
  },
