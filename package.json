{
  "name": "solana-clawd",
  "version": "1.8.2",
  "description": "HERMES x402 — Solana-Native Agentic Harness. First private x402 AI agent with OODA loop, pay.sh confidential payments, Google A2A protocol, dark DeFi intelligence, and Nous Research model routing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "solana-clawd": "dist/entrypoints/clawd.js",
    "clawd": "dist/entrypoints/clawd.js"
  },
  "files": [
    "dist/**/*",
    "tui/dist/**/*",
    "mcp/dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && npm --prefix tui install && npm --prefix tui run build && npm --prefix mcp install && npm --prefix mcp run build && node -e \"require('fs').chmodSync('dist/entrypoints/clawd.js', 0o755)\"",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prebuild": "node -e \"console.log('Building solana-clawd v' + require('./package.json').version)\"",
    "prepack": "npm run build",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:start": "npm --prefix mcp start",
    "mcp:http": "npm --prefix mcp run start:http",
    "agentwallet:build": "npm --prefix packages/agentwallet ci && npm --prefix packages/agentwallet run build",
    "agentwallet:start": "npm --prefix packages/agentwallet start",
    "vault:web:build": "npm --prefix llm-wiki-tang/web run build",
    "vault:web:dev": "npm --prefix llm-wiki-tang/web run dev",
    "demo": "node dist/entrypoints/clawd.js demo",
    "birth": "node dist/entrypoints/clawd.js birth",
    "spinners": "node dist/entrypoints/clawd.js spinners",
    "tui": "node --import tsx/esm tui/src/index.ts",
    "tui:build": "cd tui && tsc -p tsconfig.json",
    "tui:start": "node tui/dist/index.js",
    "hermes": "node --import tsx/esm tui/src/index.ts",
    "ooda": "node --import tsx/esm ooda/operator.ts",
    "goblin": "node --import tsx/esm ooda/operator.ts --llm --openai --goblin --computer-use",
    "goblin:bg": "node --import tsx/esm ooda/operator.ts --llm --openai --goblin --computer-use --background",
    "ooda:tui": "node --import tsx/esm ooda/operator.ts --tui | node --import tsx/esm ooda/tui.ts",
    "ooda:llm": "node --import tsx/esm ooda/operator.ts --llm",
    "ooda:llm:tui": "node --import tsx/esm ooda/operator.ts --llm --tui | node --import tsx/esm ooda/tui.ts",
    "ooda:fast": "node --import tsx/esm ooda/operator.ts --ticks 200 --sleep 0 --commit-every 0",
    "demo:ooda": "node --import tsx/esm examples/ooda-loop.ts",
    "demo:a2a": "node --import tsx/esm examples/a2a-demo.ts",
    "demo:paysh": "node --import tsx/esm examples/paysh-demo.ts",
    "demo:dark-defi": "node --import tsx/esm examples/dark-defi-demo.ts",
    "agent-store:list": "node --import tsx/esm payments/agent-store/index.ts list",
    "agent-store:manifest": "node --import tsx/esm payments/agent-store/index.ts manifest",
    "agent-store:join": "node --import tsx/esm payments/agent-store/index.ts join",
    "agent-store:launch": "bash payments/agent-store/launch.sh",
    "agent-store:storefront": "npm --prefix payments/agent-store/storefront run dev",
    "agent-store:pos": "npm --prefix payments/pay-main/typescript/packages/solana-pay/examples/point-of-sale run dev",
    "agent-store:truand:plan": "npm --prefix payments/agent-store/truand run plan",
    "agent-store:truand:manifest": "npm --prefix payments/agent-store/truand run manifest",
    "agent-store:truand:provision": "npm --prefix payments/agent-store/truand run provision",
    "setup": "bash scripts/setup.sh",
    "install:curl": "bash scripts/install.sh",
    "hackathon:preflight": "bash scripts/hackathon-preflight.sh",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "npm run typecheck && npm run lint",
    "ci": "npm run typecheck && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "publish:npm": "bash scripts/publish-package.sh",
    "adaptation:report": "node scripts/generate-claude-adaptation-report.mjs",
    "skill:sync": "node scripts/sync-solana-clawd-skill.mjs",
    "skills:catalog": "node scripts/generate-skills-catalog.js",
    "skills:serve": "node scripts/generate-skills-catalog.js && cp skills/catalog.json web/skills/catalog.json && npx serve web/skills -p 3333",
    "skill:solana-formal-verification:pack": "npm pack ./skills/solana-formal-verification",
    "skill:solana-formal-verification:publish": "npm publish ./skills/solana-formal-verification --access public",
    "ext:dev": "echo 'Load chrome-extension/clawd-agent as unpacked extension in chrome://extensions'",
    "ext:vault": "npm --prefix packages/agentwallet start"
  },
  "dependencies": {
    "@ai-sdk/xai": "^1.2.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "@cloudflare/sandbox": "^0.8.4",
    "@commander-js/extra-typings": "^13.1.0",
    "@growthbook/growthbook": "^1.4.0",
    "@metaplex-foundation/mpl-agent-registry": "^0.2.5",
    "@metaplex-foundation/mpl-core": "^1.9.1",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@solana-tracker/data-api": "^0.2.3",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "agentwallet-vault": "^0.1.0",
    "ai": "^5.0.52",
    "auto-bind": "^5.0.1",
    "axios": "^1.7.0",
    "bs58": "^6.0.0",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "cli-boxes": "^3.0.0",
    "code-excerpt": "^4.0.0",
    "diff": "^8.0.3",
    "ethers": "^6.13.0",
    "execa": "^9.5.0",
    "express": "^4.21.0",
    "figures": "^6.1.0",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.0",
    "ignore": "^6.0.0",
    "lodash-es": "^4.17.21",
    "marked": "^15.0.0",
    "node-pty": "^1.1.0",
    "openai": "^4.80.0",
    "p-map": "^7.0.0",
    "picomatch": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.6.0",
    "solana-claude": "^1.0.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.1.0",
    "tree-kill": "^1.2.2",
    "tweetnacl": "^1.0.3",
    "type-fest": "^5.6.0",
    "undici": "^8.0.0",
    "unicode-animations": "^1.0.3",
    "usehooks-ts": "^3.1.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@aws-sdk/credential-provider-node": "^3.972.30",
    "@biomejs/biome": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@smithy/node-http-handler": "^4.5.2",
    "@types/bun": "^1.3.11",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.0",
    "@types/picomatch": "^3.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.27.0",
    "https-proxy-agent": "^9.0.0",
    "lru-cache": "^11.3.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "sideEffects": false,
