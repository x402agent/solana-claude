# =============================================================================
# SOLANAPOLIS — Environment Variables
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# On Vercel: set every NEXT_PUBLIC_* var on Production + Preview + Development.
# Server-only secrets (HELIUS_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# OPENAI_API_KEY, NPC_WALLET_MASTER_KEY, TREASURY_PRIVATE_KEY) MUST be marked
# Sensitive in the Vercel UI and never exposed to the client bundle.
# =============================================================================

# ── Site (used for canonical URLs, sitemap, robots) ─────────────────────────
NEXT_PUBLIC_SITE_URL=https://solanapolis.com

# ── Helius (Solana RPC) ──────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_secret
HELIUS_WEBHOOK_ID=your_webhook_id

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Convex ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site

# ── Phantom Connect ──────────────────────────────────────────────────────────
NEXT_PUBLIC_PHANTOM_APP_ID=your_phantom_app_id
NEXT_PUBLIC_PHANTOM_REDIRECT_URL=https://solanpolis.netlify.app/auth/callback

# ── BirdEye (token prices) ──────────────────────────────────────────────────
BIRDEYE_API_KEY=your_birdeye_api_key

# ── Cesium Ion (Globe + Flight) ──────────────────────────────────────────────
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token

# ── Mapbox (mini-map) ───────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# ── Optional backend compatibility / widgets ────────────────────────────────
# Worker accepts either SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# ── AI / LLM (optional — for NPC conversations) ─────────────────────────────
# Recommended local setup for all agent chat / NPC dialogue:
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=8bit/DeepSolana
#
# Memory embeddings still use the current 1536-dimension Convex vector index.
# Keep an embedding provider like OpenAI unless you explicitly migrate that
# index and switch LLM_EMBEDDING_PROVIDER=ollama.
# OPENAI_API_KEY=your_openai_key
#
# Optional cloud fallbacks:
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_MODEL=x-ai/grok-4.20-multi-agent-beta
# OPENROUTER_MODEL1=minimax/minimax-m2.5:free
# OPENROUTER_MODEL2=nousresearch/hermes-3-llama-3.1-405b:free
# OPENROUTER_MODEL3=nvidia/nemotron-3-super-120b-a12b:free

# ── Treasury (optional — for parcel rewards) ─────────────────────────────────
# TREASURY_PRIVATE_KEY=your_treasury_private_key_base58

# ── AI Town NPC Wallet Vault (optional, server-side custody) ────────────────
# NPC_WALLET_MASTER_KEY=replace_with_a_long_random_secret
# NPC_WALLET_INITIAL_SOL=0.01

# ── Metaplex Agent mode (optional, replaces custodial keypairs) ─────────────
# When METAPLEX_AGENT_MODE=true and TREASURY_PRIVATE_KEY is set, new NPCs are
# minted as Metaplex Core agents. The NPC's wallet becomes an Asset Signer PDA
# (no private key exists), eliminating the need to custody NPC secret keys.
# Falls back silently to server-custody mode if the mint fails.
# METAPLEX_AGENT_MODE=true
# METAPLEX_AGENT_NETWORK=solana-devnet  # or solana-mainnet, sonic-mainnet, etc.

# ── Pixel Streaming (optional — UE5 backend) ────────────────────────────────
# NEXT_PUBLIC_PIXEL_STREAMING_URL=ws://localhost:8888

# ── Performance Tuning ───────────────────────────────────────────────────────
# LOG_LEVEL=debug|info|warn|error  (default: info in production, debug in dev)
# CACHE_TTL_MS=30000               (response cache TTL, default 30s)
# RATE_LIMIT_BYPASS=0              (set to 1 to disable rate limiting in dev)
