{
  "name": "@backroom/tui",
  "version": "1.0.0",
  "description": "🦞 Infinite Backroom TUI — Bloomberg-style terminal interface for the infinite agent backroom",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backroom": "./dist/cli.js",
    "backroom-tui": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --outdir dist --target node",
    "start": "bun run dist/cli.js",
    "run": "bun run src/cli.tsx run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-gradient": "^3.0.0",
    "react": "^18.2.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.37",
    "typescript": "^5.3.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
