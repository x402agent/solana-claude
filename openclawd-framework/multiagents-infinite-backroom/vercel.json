{
    "version": 2,
    "builds": [
      { "src": "api/main.py", "use": "@vercel/python" }
    ],
    "routes": [
      { "src": "/(.*)", "dest": "api/main.py" }
    ],
    "env": {
      "DEEPSEEK_API_KEY": "@deepseek-api-key",
      "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
      "DEEPSEEK_MODEL": "deepseek-v4-pro"
    }
  }
