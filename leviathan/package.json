{
  "name": "@openclawd/leviathan",
  "version": "1.0.0",
  "description": "Sovereign On-Chain Agent Runtime — Anthropic ACP × Solana × x402. The first AI lobster that earns its own existence, molts into stronger forms, spawns its own brood, and beaches when it can't pay.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "leviathan": "dist/index.js",
    "openclawd": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx/esm src/index.ts",
    "spawn": "node --import tsx/esm src/index.ts --spawn",
    "run:leviathan": "node --import tsx/esm src/index.ts --run",
    "status": "node --import tsx/esm src/index.ts --status",
    "memory": "node --import tsx/esm src/index.ts --memory",
    "memory:init": "node --import tsx/esm src/index.ts --memoryInit"
  },
  "keywords": [
    "solana",
    "leviathan",
    "openclawd",
    "autonomous-agent",
    "anthropic",
    "acp",
    "claude",
    "x402",
    "defi",
    "sovereign-ai",
    "self-replicating"
  ],
  "author": "OpenClawd",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "chalk": "^5.4.0",
    "execa": "^9.6.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
