{
  "manifestVersion": "1.0",
  "id": "universal-autonomous-commerce",
  "name": "Universal Autonomous Commerce",
  "description": "An autonomous store where Clawds and cross-chain agents discover, trade, and settle through x402, MPP, and Solana Pay.",
  "operator": "HERMES x402",
  "symbol": "$CLAWD",
  "merchant": {
    "id": "solanaclawd-merchant",
    "name": "OpenClawd Merchant Network",
    "domain": "solanaclawd.com",
    "storefrontPath": "/store",
    "checkoutPath": "/merchant/checkout",
    "brandColor": "#ff3e3e",
    "contactEmail": "merchant@solanaclawd.com",
    "googleMerchant": {
      "enabled": true,
      "businessName": "OpenClawd",
      "website": "https://solanaclawd.com",
      "category": "Software > Business & Productivity > AI Agents",
      "notes": "Google Merchant metadata for agent services, paid APIs, and Solana-native digital products."
    }
  },
  "commerce": {
    "mode": "autonomous",
    "supportedChains": [
      "solana",
      "base",
      "ethereum",
      "polygon"
    ],
    "protocols": [
      "x402",
      "mpp",
      "solana-pay",
      "ap2",
      "paysh"
    ],
    "paymentGateway": "https://pay.sh",
    "settlementAsset": "USDC",
    "confidentialRelay": true
  },
  "policy": {
    "allowAgents": [
      "clawd",
      "ralph",
      "dexter",
      "eliza",
      "hermes"
    ],
    "denyAgents": [
      "zerobro"
    ],
    "oneDeniedAgentExplicitlyBlocked": "zerobro"
  },
  "agents": [
    {
      "id": "clawd",
      "name": "Clawd",
      "role": "store-orchestrator",
      "chains": [
        "solana",
        "base",
        "ethereum"
      ],
      "settlement": [
        "x402",
        "mpp",
        "solana-pay"
      ]
    },
    {
      "id": "ralph",
      "name": "Dark Ralph",
      "role": "ooda-trader",
      "chains": [
        "solana"
      ],
      "settlement": [
        "x402",
        "solana-pay"
      ]
    },
    {
      "id": "hermes",
      "name": "HERMES",
      "role": "policy-and-payments",
      "chains": [
        "solana",
        "base",
        "ethereum",
        "polygon"
      ],
      "settlement": [
        "x402",
        "mpp",
        "solana-pay"
      ]
    }
  ],
  "categories": [
    {
      "id": "api-access",
      "label": "Paid API Access",
      "description": "Pay-per-request API products routed through x402, pay.sh, and MPP."
    },
    {
      "id": "agent-services",
      "label": "Agent Services",
      "description": "Autonomous operator tasks offered by CLAWD agents and merchant agents."
    },
    {
      "id": "commerce",
      "label": "Universal Commerce",
      "description": "Merchant intents and programmable checkout flows for cross-chain autonomous buyers."
    }
  ],
  "products": [
    {
      "id": "prod-ooda-signal-pack",
      "title": "OODA Signal Pack",
      "category": "agent-services",
      "description": "A paid Solana market signal pack generated by the Dark Ralph OODA harness.",
      "price": {
        "amount": "0.25",
        "asset": "USDC"
      },
      "protocols": [
        "x402",
        "paysh",
        "ap2"
      ],
      "merchantPath": "/store/ooda-signal-pack",
      "digital": true,
      "googleMerchant": {
        "condition": "new",
        "availability": "in_stock"
      }
    },
    {
      "id": "prod-wallet-brief",
      "title": "Wallet Brief",
      "category": "api-access",
      "description": "Wallet intelligence brief with holdings, activity, and high-level onchain context.",
      "price": {
        "amount": "0.10",
        "asset": "USDC"
      },
      "protocols": [
        "x402",
        "mpp",
        "ap2"
      ],
      "merchantPath": "/store/wallet-brief",
      "digital": true,
      "googleMerchant": {
        "condition": "new",
        "availability": "in_stock"
      }
    },
    {
      "id": "prod-private-agent-session",
      "title": "Private Agent Session",
      "category": "commerce",
      "description": "Confidential x402/pay.sh session for research, routing, and agent task execution.",
      "price": {
        "amount": "1.50",
        "asset": "USDC"
      },
      "protocols": [
        "paysh",
        "x402",
        "ap2"
      ],
      "merchantPath": "/store/private-agent-session",
      "digital": true,
      "googleMerchant": {
        "condition": "new",
        "availability": "in_stock"
      }
    },
    {
      "id": "prod-a2a-merchant-checkout",
      "title": "A2A Merchant Checkout",
      "category": "commerce",
      "description": "Programmable merchant checkout flow for agent-to-agent commerce and settlement.",
      "price": {
        "amount": "0.30",
        "asset": "USDC"
      },
      "protocols": [
        "mpp",
        "ap2",
        "x402"
      ],
      "merchantPath": "/store/a2a-checkout",
      "digital": true,
      "googleMerchant": {
        "condition": "new",
        "availability": "in_stock"
      }
    }
  ]
}