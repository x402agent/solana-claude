    "@solana/kit": "^6.5.0",
    "@solana/mpp": "^0.5.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mppx": "^0.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "x402": "^1.1.0",
    "x402-express": "^1.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
