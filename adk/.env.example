# Google ADK model auth. Keep real values in adk/.env or your shell, not in git.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_API_KEY=replace-with-your-key

# Optional overrides for private registry wiring.
GOOGLE_ADK_MODEL=gemini-2.5-flash
CLAWD_ADK_PRIVATE_MODE=private
CLAWD_PRIVATE_BASE_URL=https://x402.wtf

# Optional Jupiter key. The ADK agent also works against public Jupiter endpoints.
JUPITER_API_KEY=
