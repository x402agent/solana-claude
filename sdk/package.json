    },
    "./survival/monitor.js": {
      "types": "./dist/survival/monitor.d.ts",
      "default": "./dist/survival/monitor.js"
    },
    "./agent/system-prompt.js": {
      "types": "./dist/agent/system-prompt.d.ts",
      "default": "./dist/agent/system-prompt.js"
    },
    "./types/index.js": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./state/app-state.js": {
      "types": "./dist/state/app-state.d.ts",
      "default": "./dist/state/app-state.js"
    },
    "./helius/index.js": {
      "types": "./dist/helius/index.d.ts",
      "default": "./dist/helius/index.js"
    },
    "./services/x402/index.js": {
      "types": "./dist/services/x402/index.d.ts",
      "default": "./dist/services/x402/index.js"
    },
    "./services/x402/types.js": {
      "types": "./dist/services/x402/types.d.ts",
      "default": "./dist/services/x402/types.js"
    },
    "./buddy/index.js": {
      "types": "./dist/buddy/index.d.ts",
      "default": "./dist/buddy/index.js"
    }
