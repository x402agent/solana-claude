{
  "name": "@openclawdsolana/leviathan",
  "version": "0.2.0",
  "description": "OpenClawd — Sovereign AI Lobster Runtime on Solana — $CLAWD: 8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    },
    "./identity/wallet.js": {
      "types": "./dist/identity/wallet.d.ts",
      "default": "./dist/identity/wallet.js"
    },
    "./identity/balances.js": {
      "types": "./dist/identity/balances.d.ts",
      "default": "./dist/identity/balances.js"
    },
    "./identity/spawn-onchain.js": {
      "types": "./dist/identity/spawn-onchain.d.ts",
      "default": "./dist/identity/spawn-onchain.js"
    },
    "./setup/wizard.js": {
      "types": "./dist/setup/wizard.d.ts",
      "default": "./dist/setup/wizard.js"
    },
    "./molting/spawn.js": {
      "types": "./dist/molting/spawn.d.ts",
