# Server Configuration
PORT=3001
NODE_ENV=development

# Solana Configuration
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE
SOLANA_PUBLIC_KEY=YOUR_SOLANA_PUBLIC_KEY_HERE

# Target Token
TOKEN_ADDRESS=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
TELEGRAM_USER_ID=YOUR_TELEGRAM_USER_ID

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Restrict the bot to specific chat IDs and user IDs
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Birdeye
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY
BIRDEYE_CHAIN=solana
BIRDEYE_WSS_URL=wss://public-api.birdeye.so/socket/solana?x-api-key=YOUR_BIRDEYE_API_KEY

# OpenAI (text + image generation for trades)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_TEXT_MODEL=gpt-5.3-nano
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_FALLBACK=gpt-image-1
OPENAI_IMAGE_ENABLED=true
OPENAI_IMAGE_DIR=generated/trades

# AI Trading Bot Configuration
AI_ENABLED=true
AI_MODEL_PATH=models/trading_model.pkl
MIN_CONFIDENCE_SCORE=0.7
MAX_POSITION_SIZE=0.2
STOP_LOSS_PERCENTAGE=10
TAKE_PROFIT_PERCENTAGE=50

# xAI / Solana Tracker (optional)
XAI_API_KEY=YOUR_XAI_API_KEY
SOLANA_TRACKER_API_KEY=YOUR_SOLANA_TRACKER_API_KEY
SOLANA_TRACKER_RPC_API_KEY=YOUR_SOLANA_TRACKER_RPC_API_KEY
SOLANA_TRACKER_RPC_URL=https://rpc-mainnet.solanatracker.io/?api_key=YOUR_API_KEY
SOLANA_TRACKER_WSS_URL=https://rpc-mainnet.solanatracker.io/?api_key=YOUR_API_KEY

# Trading Strategy
TRADING_STRATEGY=momentum
SCALPING_ENABLED=true
SWING_TRADING_ENABLED=true

# Risk Management
MAX_DAILY_LOSS=1.0
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE=2

# AI Model Parameters
FEATURE_WINDOW=60
PREDICTION_HORIZON=5
LEARNING_RATE=0.001

# Analysis loop (increased to reduce Birdeye API quota usage)
ANALYSIS_INTERVAL_MS=300000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/ai-trading.log
