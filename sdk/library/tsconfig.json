{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts"],
  "exclude": ["node_modules", "../node_modules", "../../node_modules"]
}
