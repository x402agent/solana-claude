{
  "name": "@openclawdsolana/clawd-perps",
  "version": "1.1.0",
  "description": "ClaWD Perps — Phoenix Perpetuals DEX CLI integration for OpenClawd. Provides TypeScript market tools and delegates strategies/lifecycle to the Python Phoenix agent and Vulcan CLI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "clawd-perps": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "vulcan": "node dist/cli.js perps vulcan",
    "agent": "node dist/cli.js perps agent"
  },
  "keywords": [
    "clawd",
    "openclawd",
    "perps",
    "perpetuals",
    "phoenix",
    "solana",
    "dex",
    "trading",
    "cli"
  ],
  "author": "8bit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://solanaclawd.com",
    "directory": "openclawd-framework/packages/clawd-perps"
  },
  "homepage": "https://solanaclawd.com",
  "dependencies": {
    "@ellipsis-labs/rise": "^0.4.9",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "preferGlobal": true
}
