# Clawd Perps Aggregator — environment

# Imperial API endpoint (multi-venue router that brokers Phoenix/Flash/Jupiter/GMTrade)
IMPERIAL_API_BASE=https://api.imperial.space/api/v1

# Pre-issued Imperial JWT — required for /mobile/balances and live execution.
# Leave empty for read-only / paper mode (public reads work without it).
IMPERIAL_JWT=

# Operator wallet (base58 pubkey only, never a private key)
IMPERIAL_WALLET=

# Subaccount index 0..5
IMPERIAL_PROFILE_INDEX=0

# Set to "true" to enable live submission. Paper-first by default.
IMPERIAL_LIVE=false

# Hard cap per order, USD
IMPERIAL_MAX_SIZE_USD=100

# Symbol allowlist
IMPERIAL_ALLOWED_SYMS=SOL,ETH,BTC

# Default slippage tolerance, basis points
IMPERIAL_SLIPPAGE_BPS=50

# Comma-separated venues to enable, subset of: phoenix,flash,jupiter,gmtrade
PERPS_AGG_VENUES=phoenix,flash,jupiter,gmtrade

# Default funding-hold horizon (seconds)
PERPS_AGG_HOLD_SECONDS=3600

# Force paper mode regardless of IMPERIAL_LIVE
PERPS_AGG_PAPER=true
