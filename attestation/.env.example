# ─── Solana Network ────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet            # mainnet-beta | devnet | localnet | demo

# ─── Solana Attestation Service ───────────────────────────────────────────────
# Program ID (fixed — do not change)
SAS_PROGRAM_ID=22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG

# Your issued SAS credential (run examples/setup-credential.ts to create)
CREDENTIAL_ADDRESS=

# Schema PDAs (created via setup scripts)
TEE_SESSION_SCHEMA_ADDRESS=
INFERENCE_ATTESTATION_SCHEMA_ADDRESS=
AGENT_ROUTER_SCHEMA_ADDRESS=
MODEL_REGISTRY_SCHEMA_ADDRESS=

# Signer private key (64-byte keypair, hex-encoded)
SIGNER_PRIVATE_KEY=

# ─── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── TEE Terminal Server ──────────────────────────────────────────────────────
TEE_PORT=8443
TEE_DEMO_MODE=true               # set to false for real Solana txns

# ─── TEE Terminal Client ──────────────────────────────────────────────────────
TEE_SERVER_URL=ws://localhost:8443
SOLANA_PUBKEY=                   # your Solana wallet pubkey (base58)

# ─── Agent Router ─────────────────────────────────────────────────────────────
AGENT_ROUTER_DEMO_MODE=true      # set to false for real Solana txns
AGENT_WALLET_PUBKEY=             # agent's on-chain wallet
