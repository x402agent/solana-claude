# Clawd ORE Mining Agent — Environment Variables

# ── AI Brain (pick one) ───────────────────────────────────────────────────────

# DeepSeek (recommended — cheapest, OpenAI-compatible, thinking mode built-in)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash   # or deepseek-v4-pro for max reasoning

# OpenRouter (alternative — Claude, GPT-4o, etc.)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-opus-4.7-fast

# Anthropic direct (alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Solana ────────────────────────────────────────────────────────────────────

# RPC endpoint (Helius recommended for reliable getProgramAccounts)
RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# or: HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Path to your Solana keypair JSON file
KEYPAIR=/Users/you/.config/solana/id.json

# ── Optional tuning ──────────────────────────────────────────────────────────

# Max SOL to deploy per round (default: 0.1)
MAX_DEPLOY_SOL=0.1

# Min SOL to keep in wallet for gas (default: 0.05)
MIN_RESERVE_SOL=0.05

# CLAWD loop tick interval in milliseconds (default: 60000 = 1 min)
TICK_INTERVAL_MS=60000

# Set to "true" to observe and plan without executing any transactions
DRY_RUN=false

# Live dashboard port (default: 3333 → http://localhost:3333)
DASHBOARD_PORT=3333

# ── Build the ore-cli binary ─────────────────────────────────────────────────
# The agent uses the ore-master CLI for transaction submission.
# Build it once before running live mining:
#
#   cd ../../ore-master && cargo build --release
#
# The binary will be at: ore-master/target/release/ore-cli
