{
  "name": "@x402agent/solana-formal-verification",
  "version": "1.1.0",
  "description": "First-class Solana Clawd skill and CLI for Lean 4 formal verification of Solana programs, Rust code, and smart contracts",
  "keywords": [
    "agent-skill",
    "lean4",
    "formal-verification",
    "qedgen",
    "solana",
    "rust",
    "smart-contracts",
    "proof-assistant",
    "mistral"
  ],
  "main": "SKILL.md",
  "bin": {
    "qedgen": "./bin/qedgen"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "claude.md",
    "bin/",
    "install.sh",
    "Cargo.toml",
    "Cargo.lock",
    "crates/",
    "docs/",
    "example/"
  ],
  "scripts": {
    "postinstall": "bash install.sh",
    "prepack": "cargo build --release && mkdir -p bin && cp target/release/qedgen bin/ && chmod +x bin/qedgen",
    "pack:check": "npm pack --dry-run",
    "test": "./bin/qedgen --help"
  },
  "repository": {
