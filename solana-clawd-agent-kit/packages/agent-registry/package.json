{
  "name": "@solana-clawd/agent-registry",
  "version": "0.1.0",
  "description": "Registry document helpers for Solana Clawd agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
