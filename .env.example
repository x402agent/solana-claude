# Root runtime
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Solana data
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WSS_URL=
BIRDEYE_API_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Install tracking / Convex
CONVEX_URL=

# Secret manager — Bitwarden Secrets Manager (optional).
# When BWS_ACCESS_TOKEN is set, installers can install the bws CLI, seed this
# file, and write launchers that inject secrets at runtime via `bws run`
# (secrets never need to live here in plaintext). See docs/SECRETS.md.
BWS_ACCESS_TOKEN=
BWS_PROJECT_ID=
# BWS_SERVER_URL=        # self-hosted Bitwarden only
# SOLANA_CLAWD_BWS=0     # hard-disable Bitwarden integration

# Wallet and safety
VAULT_PASSPHRASE=
SOLANA_PRIVATE_KEY=
LIVE_TRADING=false
MAINNET_ENABLED=false
OPERATOR_CONFIRMED=false

# Public gateway / registry
GATEWAY_BASE_URL=https://x402.wtf
EXTERNAL_AGENT_REGISTRY_NAME=x402wtf
EXTERNAL_AGENT_REGISTRY_ENDPOINT_ID=urn:endpoint:projects-1013652097839:projects:1013652097839:locations:global:agentregistry:services:endpoint-x402wtf-994c-cc25cb307175
EXTERNAL_AGENT_REGISTRY_RESOURCE=projects/1013652097839/locations/global/services/endpoint-x402wtf-994c-cc25cb307175
EXTERNAL_AGENT_REGISTRY_DESTINATION_URL=https://x402.wtf/agents/registry
